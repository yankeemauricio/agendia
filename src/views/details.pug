extends layout

block content
  .nav-back
    a(href="/") 
      i.fas.fa-chevron-left
      |  VOLTAR AO CATÁLOGO
  
  article.hero-info
    .badge-original EVENTO ORIGINAL AGENDIA
    h2= event.titulo || event.title
    
    .meta-bar
      span.meta-item
        i.far.fa-calendar-check
        | #{event.data}
      span.meta-item
        i.far.fa-clock
        | #{event.horario}
      span.meta-item
        i.fas.fa-location-dot
        | #{event.local}
    
    p.description= event.descricao
    
    - const vagasTotal = event.vagas || 0
    - const ocupadas = event.participantes ? event.participantes.length : 0
    - const vagasRestantes = vagasTotal - ocupadas

    .vagas-status
      if vagasRestantes <= 0
        span.tag-esgotado 🚫 ESGOTADO
      else
        span.tag-vagas #{vagasRestantes} VAGAS RESTANTES

  section.registration-area
    div.reg-header
      i.fas.fa-ticket-alt
      h3 Solicitar Acesso
    
    p Preencha os dados abaixo para garantir sua vaga.

    //- Função fetch definida no layout
    form(onsubmit=`sendForm(event, '/events/${event.id}/register')`)
      .input-grid
        .field
          label Nome Completo
          input(type="text", name="nome", placeholder="Ex: João Silva", required)
        .field
          label E-mail
          input(type="email", name="email", placeholder="joao@email.com", required)
        .field
          label CPF
          input(type="text", name="cpf", placeholder="000.000.000-00", required)
        .field
          label Telefone / WhatsApp
          input(type="text", name="telefone", placeholder="(84) 99999-9999")
      
      if vagasRestantes > 0
        button.btn-play(type="submit") 
          i.fas.fa-check
          |  CONFIRMAR MINHA INSCRIÇÃO
      else
        button.btn-play.disabled(type="button" disabled) ESGOTADO